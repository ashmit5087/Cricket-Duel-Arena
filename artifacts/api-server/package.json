{
  "name": "cricket-dna-api",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "bootstrap:stats": "node dist/db/bootstrapStats.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "node-cache": "^5.1.2",
    "dotenv": "^16.4.1",
    "node-fetch": "^3.3.2",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
