# ── API Server ────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── Redis (caching & daily budget counter) ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password   # only if auth is enabled

# ── PostgreSQL (battle history, rivalry scores) ───────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/cricket_dna
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cricket_dna
POSTGRES_USER=cricket_admin
POSTGRES_PASSWORD=your_postgres_password

# ── ML service (optional — Python KNN + XGBoost) ─────────────────────────────
ML_URL=http://localhost:8000

# ── RapidAPI (optional paid fallback — only used if the free scraper fails) ──
# Not required. The scraper (services/scraper.ts -> ML /scrape/*) is the
# primary, free path for career stats; RapidAPI is opportunistic on top of it.
# RAPIDAPI_KEY=your_rapidapi_key_here

# ── Gemini API (optional — battle narrative generation) ───────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Frontend ──────────────────────────────────────────────────────────────────
# Set in artifacts/cricket-dna/.env.local
VITE_API_URL=http://localhost:3001
